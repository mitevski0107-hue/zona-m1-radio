# Required. Bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Live station. Defaults to Zona M1 if unset.
STREAM_URL=https://zonam1.ddns.net:8400/;

# Per-guild starting volume, 0–100. Defaults to 50.
DEFAULT_VOLUME=50

# Optional. Server where new slash commands appear immediately.
# Defaults to the Zona M1 server. Set to off to register global commands only.
COMMAND_GUILD_ID=1304175357124939776
